# =============================================================================
# .env.example — AI PR Review Agent
#
# USAGE:
#   cp .env.example .env
#   Fill in every value marked <REPLACE_ME> with your real credentials.
#   Never commit .env — it is in .gitignore.
#
# CLOUD SERVICES (recommended):
#   Postgres  -> Neon (neon.tech)           free tier, serverless
#   Redis     -> Railway Plugin             auto-injected as REDIS_URL
#   Qdrant    -> Qdrant Cloud (cloud.qdrant.io)  free 1-cluster tier
#   LLM       -> OpenAI (platform.openai.com)
#
# LOCAL DEV (no cloud accounts):
#   docker-compose -f docker-compose.dev.yml up --build
# =============================================================================

# =============================================================================
# GitHub Integration
# =============================================================================

# The secret used to sign every webhook delivery (X-Hub-Signature-256 header).
# Generate: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=<REPLACE_ME>

# Personal Access Token (classic) or fine-grained PAT.
# Scopes needed: contents:read, pull_requests:read+write
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=<REPLACE_ME>

# GitHub REST API base URL. For GHE: https://github.mycompany.com/api/v3
GITHUB_API_BASE_URL=https://api.github.com

# =============================================================================
# Database — PostgreSQL (Neon Cloud)
# =============================================================================

# asyncpg requires ssl=require (NOT sslmode=require — that is psycopg2 syntax).
# Neon connection string from: neon.tech -> project -> connection details
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>.neon.tech/<dbname>?ssl=require

# Tiger Cloud (TimescaleDB) — semantic memory + events spine
# Get this from tigerdata.com after provisioning your instance
TIGER_DATABASE_URL=postgresql+asyncpg://user:pass@host.tigerdata.com:5432/dbname
# Embedding dimension must match your model (text-embedding-3-small=1536, large=3072)
TIGER_EMBEDDING_DIM=1536

# =============================================================================
# Redis — Job Queue (Railway Plugin or local)
# =============================================================================

# Railway auto-injects REDIS_URL when you add the Redis plugin.
# For local dev this is set in docker-compose.dev.yml.
REDIS_URL=redis://localhost:6379

# =============================================================================
# LLM Providers
# =============================================================================

# =============================================================================
# LLM Providers
#
# DEFAULT: Gemini (security) + Groq (quality, test, docs) — both FREE
# OPTIONAL: OpenAI and Anthropic if you prefer paid providers
# =============================================================================

# Google Gemini API key — used for security agent (FREE: 15 RPM, 1M tokens/day)
# Get at: https://aistudio.google.com/apikey
GEMINI_API_KEY=<REPLACE_ME>

# Groq API key — used for quality, test, docs agents (FREE: 30 RPM)
# Get at: https://console.groq.com/keys
GROQ_API_KEY=<REPLACE_ME>

# OpenAI API key — optional, only if you set SECURITY_PROVIDER=openai
# OPENAI_API_KEY=<REPLACE_ME>

# Anthropic API key — optional, only if SECURITY_PROVIDER=anthropic
# ANTHROPIC_API_KEY=<REPLACE_ME>

# Embedding model for RAG ingestion (requires OpenAI key if enabled)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Which provider + model to use for each agent role.
# Defaults: gemini for security, groq for quality/test/docs
SECURITY_PROVIDER=gemini
SECURITY_MODEL=gemini-2.0-flash
QUALITY_PROVIDER=groq
QUALITY_MODEL=llama-3.1-70b-versatile
TEST_PROVIDER=groq
TEST_MODEL=llama-3.1-70b-versatile
DOCS_PROVIDER=groq
DOCS_MODEL=llama-3.1-8b-instant

# =============================================================================
# GitHub OAuth (multi-user login)
# Create at: https://github.com/settings/developers -> New OAuth App
# Callback URL: http://localhost:8001/api/v1/auth/callback
# =============================================================================
GITHUB_OAUTH_CLIENT_ID=<REPLACE_ME>
GITHUB_OAUTH_CLIENT_SECRET=<REPLACE_ME>

# JWT secret for signing session tokens.
# Generate: openssl rand -hex 64 (or PowerShell equivalent)
JWT_SECRET=<REPLACE_ME>

# JWT token expiry in hours (default 24h)
JWT_EXPIRY_HOURS=24

# Frontend URL (for OAuth redirect after login)
FRONTEND_URL=http://localhost:3000

# =============================================================================
# Application Settings
# =============================================================================

# Environment tag — used in logs and health endpoint.
APP_ENV=production

LOG_LEVEL=INFO

# Maximum number of PR review jobs running concurrently in the worker.
MAX_CONCURRENT_REVIEWS=5

# Minimum confidence score for auto-approval (0.0 - 1.0).
CONFIDENCE_THRESHOLD=0.85

# Seconds before a review workflow is killed and marked timed_out.
WORKFLOW_TIMEOUT_SECONDS=300

# API key for the internal REST endpoints (/api/v1/*).
# Used by the demo script and any external caller.
# Generate: openssl rand -hex 32
API_KEY=<REPLACE_ME>
GEMINI_API_KEY=<paste gemini key>
GROQ_API_KEY=<paste groq key>
SECURITY_PROVIDER=gemini
SECURITY_MODEL=gemini-2.0-flash

